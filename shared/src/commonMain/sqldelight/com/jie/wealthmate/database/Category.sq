import kotlinx.serialization.descriptors.PrimitiveKind.BOOLEAN;

CREATE TABLE Category (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    icon TEXT NOT NULL,
    largeCategory TEXT NOT NULL,
    middleLabel TEXT NOT NULL,
    sort INTEGER NOT NULL,
    isFixed INTEGER NOT NULL
);

CREATE TABLE CategoryTag (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    largeCategory TEXT NOT NULL,
    middleLabel TEXT NOT NULL,
    tagLabel TEXT NOT NULL
);


-- 카테고리와 태그를 연결하는 중간 테이블
CREATE TABLE CategoryTagRelation (
    categoryId INTEGER NOT NULL,
    tagId INTEGER NOT NULL,
    PRIMARY KEY (categoryId, tagId),
    FOREIGN KEY (categoryId) REFERENCES Category(id) ON DELETE CASCADE,
    FOREIGN KEY (tagId) REFERENCES CategoryTag(id) ON DELETE CASCADE
);


-- 카테고리 추가
insertCategory:
INSERT INTO Category(icon, largeCategory, middleLabel, sort, isFixed)
VALUES (?, ?, ?,?,?);

-- 마지막으로 추가된 카테고리 ID 가져오기
lastInsertRowId:
SELECT last_insert_rowid();

-- 카테고리 삭제 (CASCADE로 관계도 자동 삭제됨)
deleteCategory:
DELETE FROM Category WHERE id = ?;

-- 카테고리 조회
selectCategoryById:
SELECT * FROM Category WHERE id = ?;

-- 카테고리와 태그 함께 조회
selectCategoryWithTags:
SELECT
    Category.id AS category_id,
    Category.icon,
    Category.largeCategory,
    Category.middleLabel,
    Category.sort,
    Category.isFixed,
    CategoryTag.id AS tag_id,
    CategoryTag.tagLabel
FROM Category
LEFT JOIN CategoryTagRelation ON Category.id = CategoryTagRelation.categoryId
LEFT JOIN CategoryTag ON CategoryTagRelation.tagId = CategoryTag.id
WHERE Category.id = ?;

-- 모든 카테고리와 태그 함께 조회
selectAllCategoriesWithTags:
SELECT
    Category.id AS category_id,
    Category.icon,
    Category.largeCategory,
    Category.middleLabel,
    Category.sort,
    Category.isFixed,
    CategoryTag.id AS tag_id,
    CategoryTag.tagLabel
FROM Category
LEFT JOIN CategoryTagRelation ON Category.id = CategoryTagRelation.categoryId
LEFT JOIN CategoryTag ON CategoryTagRelation.tagId = CategoryTag.id
ORDER BY Category.id;

-- 태그 추가
insertTag:
INSERT INTO CategoryTag(largeCategory, middleLabel, tagLabel)
VALUES (?, ?, ?);

-- 태그 삭제
deleteTag:
DELETE FROM CategoryTag WHERE id = ?;

-- 카테고리-태그 관계 추가
insertCategoryTagRelation:
INSERT OR IGNORE INTO CategoryTagRelation(categoryId, tagId)
VALUES (?, ?);

-- 카테고리-태그 관계 삭제
deleteCategoryTagRelation:
DELETE FROM CategoryTagRelation
WHERE categoryId = ? AND tagId = ?;

-- 특정 카테고리의 모든 태그 관계 삭제
deleteAllTagsFromCategory:
DELETE FROM CategoryTagRelation WHERE categoryId = ?;